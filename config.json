{
  "cluster": {
    "numServers": 3,
    "serverHosts": ["localhost", "localhost", "localhost"],
    "serverBasePort": 8000
  },
  "chameleon": {
    "maxWaitMs": 400,
    "clientLostTimeoutMs": 10000,
    "rttWindowSize": 64,
    "clientRetryLimit": 3,
    "sMax": 1000,
    "controlIntervalMs": 100
  },
  "nodeFailure": {
    "enabled": false,
    "failedNodeId": 0
  },
  "timedFailure": {
    "enabled": false,
    "targetRole": "FOLLOWER",
    "afterSeconds": 40
  },
  "geo": {
    "enabled": false,
    "latencyMs": 50,
    "scriptPath": "./simulate_geo_latency.sh",
    "scriptTimeoutSeconds": 10,
    "clearOnExit": true,
    "useSudo": true
  },
  "experiment": {
    "bufferSeconds": 20,
    "runSinglePhase": false,
    "singlePhaseIndex": 0,
    "singlePhaseDurationSeconds": 60
  },
  "phases": [
    {
      "name": "Light",
      "durationSeconds": 70,
      "totalTPS": 30000,
      "readPercentage": 0.90,
      "writePercentage": 0.10,
      "readDistribution": { "EVENTUAL_LOCAL": 0.70, "EVENTUAL_MAJORITY": 0.10, "CAUSAL_LOCAL": 0.10, "CAUSAL_MAJORITY": 0.05, "LINEARIZABLE": 0.05 },
      "writeDistribution": { "1": 0.80, "2": 0.20 }
    },
    {
      "name": "Medium",
      "durationSeconds": 60,
      "totalTPS": 30000,
      "readPercentage": 0.90,
      "writePercentage": 0.10,
      "readDistribution": { "EVENTUAL_LOCAL": 0.20, "EVENTUAL_MAJORITY": 0.20, "CAUSAL_LOCAL": 0.20, "CAUSAL_MAJORITY": 0.20, "LINEARIZABLE": 0.20 },
      "writeDistribution": { "1": 0.50, "2": 0.50 }
    },
    {
      "name": "Heavy",
      "durationSeconds": 60,
      "totalTPS": 70000,
      "readPercentage": 0.90,
      "writePercentage": 0.10,
      "readDistribution": { "EVENTUAL_LOCAL": 0.05, "EVENTUAL_MAJORITY": 0.05, "CAUSAL_LOCAL": 0.10, "CAUSAL_MAJORITY": 0.10, "LINEARIZABLE": 0.70 },
      "writeDistribution": { "1": 0.20, "2": 0.80 }
    },
    {
      "name": "Recovery",
      "durationSeconds": 60,
      "totalTPS": 30000,
      "readPercentage": 0.90,
      "writePercentage": 0.10,
      "readDistribution": { "EVENTUAL_LOCAL": 0.70, "EVENTUAL_MAJORITY": 0.10, "CAUSAL_LOCAL": 0.10, "CAUSAL_MAJORITY": 0.05, "LINEARIZABLE": 0.05 },
      "writeDistribution": { "1": 0.80, "2": 0.20 }
    }
  ]
}
